# Copy this file to .env.local and fill in values.
# Never commit .env.local to version control.

# Backend API base URL (no trailing slash).
#   local:      http://localhost:8000
#   deployed:   https://api.myschoolos.io
NEXT_PUBLIC_API_BASE_URL=

# App display name
NEXT_PUBLIC_APP_NAME=SchoolOS

# App URL (used for og tags, sitemap, etc.)
NEXT_PUBLIC_APP_URL=

# School subdomain base domain — must match the backend's School.subdomain
# ({slug}{SCHOOL_SUBDOMAIN_SUFFIX}.myschoolos.io). For local dev, use lvh.me to
# test subdomains.
#
# ALWAYS THE BARE APEX, IN EVERY DEPLOYED ENVIRONMENT — myschoolos.io, never
# an environment-specific host such as frontend-dev.myschoolos.io. The
# hosted-dev "-dev" hosting suffix is detected automatically from the current
# hostname (see src/lib/tenant/tenant-host.ts); setting this var per-
# environment instead produces a hand-off host two labels past the apex,
# which the *.myschoolos.io wildcard DNS/worker and the backend's CORS
# regex both reject.
NEXT_PUBLIC_SCHOOL_DOMAIN=myschoolos.io

# Feature flags (optional, leave blank to disable)
NEXT_PUBLIC_ENABLE_ANALYTICS=
