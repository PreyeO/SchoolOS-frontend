# Copy this file to .env.local and fill in values.
# Never commit .env.local to version control.

# Backend API base URL (no trailing slash).
#   local:      http://localhost:8000
#   deployed:   https://api.myschoolos.io
NEXT_PUBLIC_API_BASE_URL=

# App display name
NEXT_PUBLIC_APP_NAME=SchoolOS

# App URL (used for og tags, sitemap, etc.)
NEXT_PUBLIC_APP_URL=

# School subdomain base domain — must match the backend's School.subdomain
# ({slug}.myschoolos.io). For local dev, use lvh.me to test subdomains.
NEXT_PUBLIC_SCHOOL_DOMAIN=myschoolos.io

# Feature flags (optional, leave blank to disable)
NEXT_PUBLIC_ENABLE_ANALYTICS=
